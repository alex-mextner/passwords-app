<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  SPDX-FileCopyrightText: 2026 Alex Mextner
  SPDX-License-Identifier: MIT

  Session-bus API of passwords-appd.
  Bus name: io.github.alex_mextner.Passwords   Object: /io/github/alex_mextner/Passwords

  Item dict (a{sv}) keys:
    id s, url s, username s, title s, notes s, alt_urls as, group s,
    created x (unix ms), modified x (unix ms), has_code b,
    sync_problem s - "" while the item syncs; otherwise why iCloud refuses to store it, in
                   plain language (the password stays on this computer only). In List(),
                   Get() and Match(); "" inside trash entries. ItemsChanged names an item
                   whenever its sync_problem changes.
    password s   - only in Get() and Save() input
    otpauth s    - only in Get() and Save() input; never returned by Match()
  Save(): "id" absent or "" creates; otherwise updates that id. Unknown keys are rejected.
    The read-only keys (created, modified, has_code, sync_problem) are accepted and ignored,
    so a dict from Get() can be sent back unchanged.

  Trash entry dict keys: trash_id s, reason s, deleted_at x, expires_at x, item a{sv} (no password).

  Status dict keys:
    state s (signed-out | syncing | idle | paused | offline | signin-required | error),
    apple_id s, item_count u, trash_count u, last_sync x (0 = never), next_sync x,
    message s, pending_local_deletions as, pending_remote_deletions as,
    join_pending b (signed in with the password and the verification code done; only the
    device passcode is missing: clients continue at the device step, not at the password)

  Sign-in step dict keys:
    step s (code | device | done), destination s (trusted-device | sms), message s

  Recovery device dict keys (ListRecoveryDevices): id s, name s, model s, serial s.
    Apple keeps a copy of the keychain keys sealed with the screen passcode of each of the
    user's devices (Apple's "iCloud Keychain recovery", internally an escrow record). Joining
    proves knowledge of ONE device's passcode; Apple allows ~10 wrong attempts per device,
    then destroys that copy. Never call JoinKeychain without explicit user confirmation.

  Errors (org.freedesktop.DBus.Error.* plus):
    io.github.alex_mextner.Passwords1.Error.NotFound
    io.github.alex_mextner.Passwords1.Error.Invalid
    io.github.alex_mextner.Passwords1.Error.Unavailable
    io.github.alex_mextner.Passwords1.Error.AuthRequired
    io.github.alex_mextner.Passwords1.Error.WrongCode
    io.github.alex_mextner.Passwords1.Error.WrongPasscode   (message carries remaining attempts if known)
    io.github.alex_mextner.Passwords1.Error.Locked
-->
<node>
  <interface name="io.github.alex_mextner.Passwords1">
    <method name="GetStatus">
      <arg name="status" type="a{sv}" direction="out"/>
    </method>
    <method name="List">
      <arg name="items" type="aa{sv}" direction="out"/>
    </method>
    <method name="Get">
      <arg name="id" type="s" direction="in"/>
      <arg name="item" type="a{sv}" direction="out"/>
    </method>
    <method name="Save">
      <arg name="item" type="a{sv}" direction="in"/>
      <arg name="id" type="s" direction="out"/>
    </method>
    <method name="Delete">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="ListTrash">
      <arg name="entries" type="aa{sv}" direction="out"/>
    </method>
    <method name="Restore">
      <arg name="trash_id" type="s" direction="in"/>
      <arg name="id" type="s" direction="out"/>
    </method>
    <method name="Purge">
      <arg name="trash_id" type="s" direction="in"/>
    </method>
    <method name="SyncNow"/>
    <method name="ResolvePause">
      <arg name="apply" type="b" direction="in"/>
    </method>
    <method name="Match">
      <arg name="url" type="s" direction="in"/>
      <arg name="items" type="aa{sv}" direction="out"/>
    </method>
    <method name="GetCode">
      <arg name="id" type="s" direction="in"/>
      <arg name="code" type="s" direction="out"/>
      <arg name="seconds_left" type="u" direction="out"/>
    </method>
    <method name="SignInStart">
      <arg name="apple_id" type="s" direction="in"/>
      <arg name="password" type="s" direction="in"/>
      <arg name="step" type="a{sv}" direction="out"/>
    </method>
    <method name="SignInCode">
      <arg name="code" type="s" direction="in"/>
      <arg name="step" type="a{sv}" direction="out"/>
    </method>
    <method name="SignInRequestSms">
      <arg name="step" type="a{sv}" direction="out"/>
    </method>
    <method name="ListRecoveryDevices">
      <arg name="devices" type="aa{sv}" direction="out"/>
    </method>
    <method name="JoinKeychain">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="passcode" type="s" direction="in"/>
      <arg name="step" type="a{sv}" direction="out"/>
    </method>
    <method name="SignOut"/>
    <signal name="StatusChanged">
      <arg name="status" type="a{sv}"/>
    </signal>
    <signal name="ItemsChanged">
      <arg name="ids" type="as"/>
    </signal>
  </interface>
</node>

<component type="desktop-application">
  <!-- appstreamcli pedantic note cid-contains-uppercase-letter is expected: the app id is
       fixed (bus names, desktop id, GSettings path, and the D-Bus contract all use it). -->
  <id>io.github.alex_mextner.Passwords</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Passwords</name>
  <summary>Keep website passwords in sync with iCloud Keychain</summary>
  <developer id="io.github.alex_mextner">
    <name>Alex Mextner</name>
  </developer>
  <description>
    <p>
      Passwords makes your Linux desktop a full peer of your iPhone, iPad and Mac for website
      passwords. Add, edit or delete a password anywhere and the change shows up everywhere.
    </p>
    <ul>
      <li>Two-way sync with iCloud Keychain, including shared password groups</li>
      <li>Two-way sync with GNOME Keyring, so other apps see the same passwords</li>
      <li>Verification codes for two-factor sign-in, with a live countdown</li>
      <li>Security recommendations for weak, reused and leaked passwords</li>
      <li>Deleted passwords are kept for 90 days and can be restored</li>
      <li>Autofill in Firefox and Chrome through a companion browser extension</li>
    </ul>
    <p>
      Your passwords stay end-to-end encrypted between your devices and Apple's servers.
      No server run by this project ever sees a password.
    </p>
  </description>
  <launchable type="desktop-id">io.github.alex_mextner.Passwords.desktop</launchable>
  <url type="homepage">https://github.com/alex-mextner/passwords-app</url>
  <url type="bugtracker">https://github.com/alex-mextner/passwords-app/issues</url>
  <url type="vcs-browser">https://github.com/alex-mextner/passwords-app</url>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <translation type="gettext">passwords-app</translation>
  <provides>
    <binary>passwords-app</binary>
    <dbus type="user">io.github.alex_mextner.Passwords.App</dbus>
  </provides>
  <screenshots>

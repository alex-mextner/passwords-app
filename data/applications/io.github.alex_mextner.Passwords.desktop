[Desktop Entry]
Type=Application
Name=Passwords
Name[ru]=Пароли
GenericName=Password Manager
GenericName[ru]=Менеджер паролей
Comment=Keep website passwords in sync with iCloud Keychain
Comment[ru]=Пароли сайтов, синхронизированные со Связкой ключей iCloud
Keywords=password;keychain;icloud;login;2fa;totp;passkey;security;
Keywords[ru]=пароль;пароли;связка;ключи;icloud;логин;вход;2fa;totp;код;безопасность;
Exec=passwords-app
Icon=io.github.alex_mextner.Passwords
Terminal=false
Categories=Utility;GTK;GNOME;
StartupNotify=true
X-GNOME-UsesNotifications=true
Actions=new-password;

[Desktop Action new-password]
Name=New Password
Name[ru]=Новый пароль
Exec=passwords-app --new

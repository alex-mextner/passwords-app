<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Passwords</vendor>
  <vendor_url>https://github.com/alex-mextner/passwords-app</vendor_url>
  <icon_name>io.github.alex_mextner.Passwords</icon_name>
  <action id="io.github.alex_mextner.Passwords.unlock">
    <description>Unlock Passwords</description>
    <description xml:lang="ru">Разблокировать «Пароли»</description>
    <message>Authentication is required to unlock your passwords</message>
    <message xml:lang="ru">Для разблокировки паролей требуется аутентификация</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>

#
# User unit for the sync daemon. scripts/install.sh fills in @BINDIR@, @DATADIR@ and
# @CONFIGDIR@ and installs it to ~/.config/systemd/user/.

[Unit]
Description=Passwords sync (iCloud Keychain and GNOME Keyring)
Documentation=https://github.com/alex-mextner/passwords-app
# The keyring, the notification server and the app all live in the graphical session.
PartOf=graphical-session.target
After=graphical-session.target
# Exit 75 (keyring still locked at login) is retried forever, never "start limit hit".
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=io.github.alex_mextner.Passwords
ExecStart=@BINDIR@/passwords-appd
Restart=on-failure
RestartSec=15
UMask=0077

# Effective in every user manager (seccomp / prctl based):
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Mount-namespace hardening: applied where the user manager may create user namespaces.
# (Ubuntu's kernel.apparmor_restrict_unprivileged_userns=1 makes systemd skip these
# silently; PrivateDevices/ProtectClock/ProtectKernel{Modules,Logs} and
# CapabilityBoundingSet are left out because they make a user unit fail outright there.)
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-@DATADIR@ -@CONFIGDIR@
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes

[Install]
WantedBy=graphical-session.target
